# MarketDesk configuration. Copy to .env and fill in. Never commit .env.

# --- Mode -------------------------------------------------------------------
# production | development | test. Production refuses to start without owner credentials and a session secret.
MARKETDESK_ENV=production
# Real market data from Yahoo Finance via yfinance. (`fixture` is a synthetic test harness used only by the
# automated tests; it is refused in production.)
DATA_PROVIDER=yahoo

# --- Owner login (required in production) -----------------------------------
OWNER_USERNAME=owner
# argon2 hash, generate with:  docker compose run --rm web python -m marketdesk.cli hash-password
# Keep the SINGLE QUOTES: the hash contains '$' characters that Compose would otherwise interpolate.
OWNER_PASSWORD_HASH=''
# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Sign-ins are signed with it and last 90 days (renewed while you use the app); rotating it signs everyone out.
SESSION_SECRET=
# SESSION_TTL_HOURS=2160
# HTTPS deployments keep this true (default in production). Set false only for plain-HTTP on localhost.
# COOKIE_SECURE=true
# Extra browser origins allowed to call the API with cookies (comma separated). Same-origin needs nothing.
# ALLOWED_ORIGINS=https://desk.example.com

# --- Development only ---------------------------------------------------------
# Skips login on a local machine. Rejected unless MARKETDESK_ENV=development.
# DEV_AUTH_BYPASS=false

# --- Provider tuning (product defaults, not claims about Yahoo limits) --------
# QUOTE_TTL_SECONDS=300
# HISTORY_TTL_SECONDS=3600
# FUNDAMENTALS_TTL_SECONDS=86400
# SEARCH_TTL_SECONDS=86400
# PROVIDER_TIMEOUT_SECONDS=15
# PROVIDER_MAX_CONCURRENCY=4
# PROVIDER_MAX_RETRIES=2

# --- Alert worker --------------------------------------------------------------
# How often the worker samples quotes for active alerts (seconds).
# ALERT_POLL_SECONDS=300

# --- Storage -------------------------------------------------------------------
# Default: SQLite in DATA_DIR (/data in the container) — needs a persistent disk/volume there.
# DATA_DIR=/data
# Or an external PostgreSQL database (e.g. a free Neon project). postgres:// URLs are accepted as given;
# keep ?sslmode=require for hosted databases. With this set, no disk is needed.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Compose helpers -----------------------------------------------------------
# MARKETDESK_PORT=8000
# Base images can point at a registry mirror if Docker Hub rate-limits you:
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim
# NODE_IMAGE=mirror.gcr.io/library/node:22-slim
